

# set global aliases 

# dnf installation specific aliases for Fedora
alias pacu="sudo dnf upgrade -y"

# directories & files
if [ -e "/usr/bin/lsd" ]; then #use ls replace if lsd exist 
    alias ls="lsd"
    alias ll="eza --long --header"
    alias la="eza --long --header -a" 
else
    alias ll="ls -l"
    alias lla="ls -la"
fi




# docker
alias dcu="docker compose up -d"
alias dcd="docker compose down"
alias dps="docker ps -a"

# git 
alias gl="git log --all --decorate --oneline --graph"
alias gs="git status"

# development
# alias py="python3"
# alias python="python3"
# alias pip="pip3"

# global aliases [example alias -g G="| grep" --> ls G keyword]
alias -g G="| grep"
alias -g M="| more"

# check if neovim exist
if  type "nvim" > /dev/null; then
	alias v="nvim"
else
	alias v="vim"
fi

# others
alias cat="batcat"
alias rm="rm -i"

